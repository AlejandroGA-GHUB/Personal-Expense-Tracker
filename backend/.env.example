# Copy this file to backend/.env and edit. backend/.env is gitignored.
# Every setting below is optional - with no .env at all the app runs exactly as
# it always has, using keyword-based categorization only.

# === LOCAL LLM CATEGORIZATION (optional) ===
# When enabled, transactions that keyword matching can't confidently place are
# sent to a local Ollama model, which either picks one of your existing
# categories or proposes a new one for you to approve in the upload preview.
# Nothing leaves your machine.
#
# Setup:
#   1. Install Ollama       https://ollama.com
#   2. Pull any chat model  ollama pull <model>
#   3. Set the two values below and restart the backend
#
# If Ollama isn't running, the model name is wrong, or the call times out, the
# import still succeeds - those rows just fall back to "Other".

LLM_ENABLED=false

# The model tag exactly as `ollama list` reports it. There is no default: pick a
# model you actually have. Instruction-tuned models in the 7B-14B range work well
# for this; smaller ones are faster, larger ones handle ambiguous merchants better.
# Examples: qwen2.5:7b-instruct, qwen2.5:14b, llama3.1:8b, mistral:7b
LLM_MODEL=

# Where Ollama is listening. Change only if you moved it off the default port.
LLM_BASE_URL=http://localhost:11434

# Seconds to wait for one response. The first call after a cold start pays a
# ~15s model load; later calls are typically sub-second.
LLM_TIMEOUT_SECONDS=30
